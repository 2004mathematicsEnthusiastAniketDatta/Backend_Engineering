<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: Arial, sans-serif;
            background-color: #f3f3f3;
        }
        
        .header {
            background-color: #232f3e;
            color: white;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .logo {
            font-size: 24px;
            font-weight: bold;
        }
        
        .container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 20px;
        }
        
        .cart-items {
            background: white;
            padding: 20px;
            border-radius: 8px;
        }
        
        .cart-header {
            border-bottom: 1px solid #ddd;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        
        .cart-item {
            display: flex;
            padding: 20px 0;
            border-bottom: 1px solid #ddd;
        }
        
        .item-image {
            width: 120px;
            height: 120px;
            object-fit: cover;
            margin-right: 20px;
        }
        
        .item-details {
            flex: 1;
        }
        
        .item-title {
            font-size: 16px;
            color: #007185;
            margin-bottom: 5px;
        }
        
        .item-price {
            font-size: 18px;
            font-weight: bold;
            color: #B12704;
            margin: 10px 0;
        }
        
        .quantity-controls {
            display: flex;
            align-items: center;
            margin: 10px 0;
        }
        
        .quantity-btn {
            background: #f0f2f2;
            border: 1px solid #d5d9d9;
            padding: 5px 10px;
            cursor: pointer;
        }
        
        .quantity-input {
            width: 50px;
            text-align: center;
            padding: 5px;
            border: 1px solid #d5d9d9;
            margin: 0 5px;
        }
        
        .remove-btn {
            color: #007185;
            background: none;
            border: none;
            cursor: pointer;
            text-decoration: underline;
        }
        
        .cart-summary {
            background: white;
            padding: 20px;
            border-radius: 8px;
            height: fit-content;
        }
        
        .summary-row {
            display: flex;
            justify-content: space-between;
            margin: 10px 0;
        }
        
        .total-row {
            border-top: 1px solid #ddd;
            padding-top: 10px;
            font-weight: bold;
            font-size: 18px;
        }
        
        .checkout-btn {
            width: 100%;
            background: #ffd814;
            border: 1px solid #fcd200;
            border-radius: 20px;
            padding: 12px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 15px;
        }
        
        .checkout-btn:hover {
            background: #f7ca00;
        }
        
        .empty-cart {
            text-align: center;
            padding: 50px;
            background: white;
            border-radius: 8px;
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="logo">Hi</div>
        <div>Shopping Cart</div>
    </header>

    <div class="container">
        <div class="cart-items">
            <div class="cart-header">
                <h2>Shopping Cart</h2>
            </div>
            
            <% if (typeof cartItems !== 'undefined' && cartItems.length > 0) { %>
                <% cartItems.forEach(item => { %>
                <div class="cart-item">
                    <img src="<%= item.image || '/placeholder.jpg' %>" alt="<%= item.name %>" class="item-image">
                    <div class="item-details">
                        <div class="item-title"><%= item.name %></div>
                        <div class="item-price">$<%= item.price %></div>
                        <div class="quantity-controls">
                            <button class="quantity-btn" onclick="updateQuantity('<%= item.id %>', -1)">-</button>
                            <input type="number" value="<%= item.quantity %>" class="quantity-input" readonly>
                            <button class="quantity-btn" onclick="updateQuantity('<%= item.id %>', 1)">+</button>
                        </div>
                        <button class="remove-btn" onclick="removeItem('<%= item.id %>')">Remove</button>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <div class="empty-cart">
                    <h3>Your cart is empty</h3>
                    <p>Add items to your cart to see them here.</p>
                </div>
            <% } %>
        </div>

        <div class="cart-summary">
            <h3>Order Summary</h3>
            <% if (typeof cartItems !== 'undefined' && cartItems.length > 0) { %>
                <% let subtotal = cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0); %>
                <div class="summary-row">
                    <span>Subtotal:</span>
                    <span>$<%= subtotal.toFixed(2) %></span>
                </div>
                <div class="summary-row">
                    <span>Shipping:</span>
                    <span>FREE</span>
                </div>
                <div class="summary-row">
                    <span>Tax:</span>
                    <span>$<%= (subtotal * 0.08).toFixed(2) %></span>
                </div>
                <div class="summary-row total-row">
                    <span>Total:</span>
                    <span>$<%= (subtotal * 1.08).toFixed(2) %></span>
                </div>
                <button class="checkout-btn" onclick="proceedToCheckout()">Proceed to Checkout</button>
            <% } else { %>
                <p>No items in cart</p>
            <% } %>
        </div>
    </div>

    <script>
        function updateQuantity(itemId, change) {
            // Send AJAX request to update quantity
            fetch('/cart/update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ itemId, change })
            }).then(() => {
                location.reload();
            });
        }

        function removeItem(itemId) {
            fetch('/cart/remove', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ itemId })
            }).then(() => {
                location.reload();
            });
        }

        function proceedToCheckout() {
            window.location.href = '/checkout';
        }
    </script>
</body>
</html>