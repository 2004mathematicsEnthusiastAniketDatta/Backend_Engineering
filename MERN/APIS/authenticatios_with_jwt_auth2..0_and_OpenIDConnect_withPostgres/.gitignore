# Production-ready .gitignore for a Node/MERN project (Postgres, Docker, VS Code, Windows/macOS)

# Node
node_modules/
.pnpm-store/

# Build / output
dist/
build/
lib/
out/
.next/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage
coverage/
.nyc_output/

# Runtime / temporary files
tmp/
temp/
.pids/
*.pid
*.seed
*.pid.lock
upload_tmp/

# Environment & secrets (do NOT commit credentials)
.env
.env.local
.env.*.local
.env.test
.env.production
.secrets/
secrets.json

# Keys / certificates
*.key
*.pem
*.pfx
ssl/

# Databases / data directories
pgdata/
postgres-data/
*.sqlite
*.sqlite3
*.psql_history

# Docker (local override files / build artifacts)
docker-compose.override.yml
.docker/
docker/*.log

# IDE / editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~.nib

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Misc
coverage-reports/
reports/
*.stackdump
core
node_repl_history

# Keep lockfiles (package-lock.json / yarn.lock) committed for reproducible deployments